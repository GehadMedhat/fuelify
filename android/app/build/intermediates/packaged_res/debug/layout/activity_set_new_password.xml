<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_rectangle">

        <ImageView
            android:id="@+id/rgbkz6k1gjao"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="13dp"
            android:layout_marginStart="30dp"
            android:src="@drawable/back_arrow"
            android:scaleType="fitXY"/>

        <TextView
            android:id="@+id/r7e74mqdkfhe"
            android:textColor="#000000"
            android:textSize="31sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="41dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Set New Password"/>

        <TextView
            android:id="@+id/rifyd9vfwi3d"
            android:textColor="#000000"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="40dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Create a unique password."/>

        <ImageView
            android:id="@+id/loginImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/newpassword"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp"/>

        <!-- Reset Code -->
        <TextView
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="42dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Reset Code"/>

        <EditText
            android:inputType="number"
            android:hint="Enter the 6-digit code"
            android:id="@+id/resetCodeInput"
            android:textColor="#000000"
            android:textColorHint="#8A8C90"
            android:textSize="14sp"
            android:maxLength="6"
            android:layout_marginBottom="27dp"
            android:layout_marginHorizontal="42dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_frame"
            android:paddingVertical="16dp"
            android:paddingHorizontal="18dp"/>

        <!-- New Password -->
        <TextView
            android:id="@+id/r8ynxk983ecj"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="42dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="New Password"/>

        <LinearLayout
            android:id="@+id/r2et0ydvs4o5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/white_frame"
            android:paddingRight="18dp"
            android:layout_marginBottom="27dp"
            android:layout_marginHorizontal="42dp"
            android:orientation="horizontal">

            <EditText
                android:inputType="textPassword"
                android:hint="Create new password"
                android:background="@null"
                android:id="@+id/rehhqp4u7ksb"
                android:textColor="#000000"
                android:textColorHint="#8A8C90"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="16dp"
                android:paddingLeft="18dp"/>

            <ImageView
                android:id="@+id/rti8b274681a"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/eye"
                android:scaleType="fitXY"/>
        </LinearLayout>

        <!-- Confirm Password -->
        <TextView
            android:id="@+id/r1a96y6k1ekn"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="42dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Confirm Password"/>

        <LinearLayout
            android:id="@+id/r1mqdnuyds8t"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/white_frame"
            android:paddingRight="18dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="42dp"
            android:orientation="horizontal">

            <EditText
                android:inputType="textPassword"
                android:hint="Re-enter password"
                android:background="@null"
                android:id="@+id/rqtdpu3cg5vd"
                android:textColor="#000000"
                android:textColorHint="#8A8C90"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="16dp"
                android:paddingLeft="18dp"/>

            <ImageView
                android:id="@+id/rew5jukqcgn4"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/eye"
                android:scaleType="fitXY"/>
        </LinearLayout>

        <!-- Reset Button -->
        <LinearLayout
            android:id="@+id/r6yvcdehx5wg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/green_rectangle"
            android:paddingVertical="19dp"
            android:layout_marginBottom="30dp"
            android:layout_marginHorizontal="42dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rb4se4rdw8zk"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Reset Password"/>
        </LinearLayout>

        <!-- Back to Login -->
        <LinearLayout
            android:id="@+id/rcbvopfqpspp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="40dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/r3xx4lw3g13z"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rldumgthoik"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/back_arrow"
                    android:scaleType="fitXY"/>

                <TextView
                    android:id="@+id/rx5c7ew7ay8"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Back to login?"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>