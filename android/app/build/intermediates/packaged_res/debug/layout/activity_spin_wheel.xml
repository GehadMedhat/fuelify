<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FFF0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnSpinBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/button_arrow"
                android:layout_marginEnd="12dp"/>>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Meal Wheel"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111111"/>
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Spin to discover your next healthy meal"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp"/>

        <!-- Wheel container -->
        <FrameLayout
            android:id="@+id/wheelContainer"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvSpinsLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="2 spins per day"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <!-- Spin button -->
        <LinearLayout
            android:id="@+id/btnSpin"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_completed"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎰  SPIN THE WHEEL"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Spin again (hidden until result) -->
        <TextView
            android:id="@+id/btnSpinAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="↩ Spin Again"
            android:textColor="#4A6200"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- ── Result Card ── -->
        <LinearLayout
            android:id="@+id/layoutResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_recommended_card"
            android:elevation="4dp"
            android:visibility="gone"
            android:layout_marginHorizontal="20dp">

            <!-- Meal Image -->
            <ImageView
                android:id="@+id/imgSpinMeal"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_image_placeholder"/>

            <!-- Discount badge overlay -->
            <TextView
                android:id="@+id/tvSpinDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="-16dp"
                android:background="@drawable/bg_badge_completed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="−15%"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Reason badge -->
                <TextView
                    android:id="@+id/tvSpinReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_time"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp"
                    android:text="Perfect for your goal 🎯"/>

                <!-- Meal name -->
                <TextView
                    android:id="@+id/tvSpinMealName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginBottom="4dp"/>

                <!-- Meta -->
                <TextView
                    android:id="@+id/tvSpinMealMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"/>

                <!-- Macros -->
                <TextView
                    android:id="@+id/tvSpinMacros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="16dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="12dp"/>

                <!-- Pricing block -->
                <TextView
                    android:id="@+id/tvSpinBasePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:text="Original: 25.99 EGP"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvSpinFinalPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#4A6200"
                        android:text="22.09 EGP"/>
                </LinearLayout>

                <!-- Discount code box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Discount Code"
                            android:textSize="11sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvDiscountCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#4A6200"
                            android:fontFamily="monospace"/>

                        <TextView
                            android:id="@+id/tvCodeExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCopyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_completed"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Copy"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Order buttons -->
                <LinearLayout
                    android:id="@+id/btnOrderCloudKitchen"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_badge_completed"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽  Order from Cloud Kitchen  (discount applied)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnOrderTalabat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/dark_orange_rectangle"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛵  Search on Talabat"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
