<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/back_arrow"
                android:scaleType="fitCenter"
                android:contentDescription="Back"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REWARDS"
                    android:textColor="#5B9E1E"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Reward"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Reward Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reward Name"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etRewardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Free Protein Bar"
            android:inputType="textCapSentences"
            android:background="@drawable/white_card_rounded"
            android:textColor="#1A1A1A"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:padding="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe this reward..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top"
            android:background="@drawable/white_card_rounded"
            android:textColor="#1A1A1A"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:padding="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Points Required -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points Required"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPointsRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 500"
            android:inputType="number"
            android:background="@drawable/white_card_rounded"
            android:textColor="#1A1A1A"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:padding="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Category -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_card_rounded"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"/>

        </LinearLayout>

        <!-- Image Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reward Image"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/white_card_rounded"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/rewardImagePreview"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:background="#fff"
                    android:contentDescription="Reward image preview"/>

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/dark_circle_overlay"/>

                <ImageView
                    android:id="@+id/cameraIconOverlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/camera_icon_large"
                    android:contentDescription="Pick image"/>

            </FrameLayout>

            <TextView
                android:id="@+id/changePhotoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to select image"
                android:textColor="#A3E635"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Terms -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter terms and conditions..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top"
            android:background="@drawable/white_card_rounded"
            android:textColor="#1A1A1A"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:padding="16dp"
            android:layout_marginBottom="32dp"/>

        <!-- Submit Button -->
        <LinearLayout
            android:id="@+id/btnAddReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/green_rectangle"
            android:paddingVertical="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvBtnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Reward"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>