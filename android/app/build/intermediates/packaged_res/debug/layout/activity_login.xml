<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_rectangle">

        <ImageView
            android:id="@+id/rca589uz20jt"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="30dp"
            android:src="@drawable/back_arrow"
            android:scaleType="fitXY"/>

        <TextView
            android:id="@+id/rdm4xcydrdq"
            android:textColor="#000000"
            android:textSize="31sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="41dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Login Account"/>

        <TextView
            android:id="@+id/rcq8xbhnq2rh"
            android:textColor="#000000"
            android:textSize="15sp"
            android:layout_marginBottom="36dp"
            android:layout_marginStart="40dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Welcome Back!"/>

        <ImageView
            android:id="@+id/loginImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/login"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/rwsnjcynq5zq"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="46dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Email Address"/>

        <EditText
            android:inputType="textEmailAddress"
            android:hint="Enter email address"
            android:id="@+id/r7kagbk3dpnj"
            android:textColor="#000000"
            android:textColorHint="#8A8C90"
            android:textSize="14sp"
            android:layout_marginBottom="27dp"
            android:layout_marginHorizontal="46dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_frame"
            android:padding="18dp"/>

        <TextView
            android:id="@+id/rog7nqwagtx"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="46dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Password"/>

        <LinearLayout
            android:id="@+id/ry5cso10c6he"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/white_frame"
            android:paddingRight="18dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="46dp"
            android:orientation="horizontal">

            <EditText
                android:inputType="textPassword"
                android:hint="Enter your Password"
                android:background="@null"
                android:id="@+id/rrdxgaebywo9"
                android:textColor="#000000"
                android:textColorHint="#8A8C90"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:paddingLeft="18dp"/>

            <ImageView
                android:id="@+id/rlhctwdh473"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/eye"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle password visibility"/>
        </LinearLayout>

        <TextView
            android:id="@+id/r1hht59hz75e"
            android:textColor="#A3E635"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="46dp"
            android:layout_marginBottom="24dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="end"
            android:text="Forgot Password?"/>

        <!-- Patient / User Login button -->
        <LinearLayout
            android:id="@+id/rtnp02mf2r4g"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/green_rectangle"
            android:paddingVertical="16dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="46dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rql2hmecaeq"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Login"/>
        </LinearLayout>

        <!-- Doctor Login / Signup button -->
        <LinearLayout
            android:id="@+id/btnDoctorLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/white_rounded_outline"
            android:paddingVertical="14dp"
            android:layout_marginBottom="22dp"
            android:layout_marginHorizontal="46dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3C3C3C"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="🩺  Login / Sign up as Doctor"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r5e3ml9t0ovr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="40dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rbf1lon5oxih"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="#000000"
                android:text="Don't have an account?"/>
            <TextView
                android:id="@+id/rloginClickable"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="#A3E635"
                android:text="Signup"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
