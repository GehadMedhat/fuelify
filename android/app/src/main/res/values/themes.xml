<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main Fuelify theme -->
    <style name="Theme.Fuelify" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">#C3E66E</item>
        <item name="colorPrimaryVariant">#A8CC55</item>
        <item name="colorOnPrimary">#000000</item>

        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Global Font -->
        <item name="android:fontFamily">@font/urbanist_regular</item>
        <item name="fontFamily">@font/urbanist_regular</item>

        <!-- Applies GreenButton style to every Button app-wide -->
        <item name="materialButtonStyle">@style/GreenButton</item>

    </style>

    <style name="cr12">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.Fuelify.Light" parent="Theme.Fuelify">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AndroidProject" parent="Theme.Fuelify"/>

</resources>