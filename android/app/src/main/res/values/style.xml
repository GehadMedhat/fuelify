<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Green button style — applied to every Button automatically via themes.xml -->
    <style name="GreenButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/green_button_bg</item>
        <item name="rippleColor">#80FFFFFF</item>
        <item name="android:fontFamily">@font/urbanist</item>
        <item name="fontFamily">@font/urbanist</item>
    </style>

    <!-- Corner radius styles used by auth screens -->
    <style name="cr50">
        <item name="cornerSize">50dp</item>
    </style>

    <style name="RoundedTop">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="RoundedBottom" parent="">
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>

</resources>
